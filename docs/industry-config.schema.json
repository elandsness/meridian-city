{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meridian Semantic Industry Config",
  "type": "object",
  "required": [
    "version",
    "company",
    "theme",
    "screens"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "primaryFlow": {
      "type": "string"
    },
    "company": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "short": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "assistant": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "persona": {
              "type": "string"
            },
            "supportPhone": {
              "type": "string"
            },
            "systemPrompt": {
              "type": "string"
            }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "required": [
        "colors"
      ],
      "properties": {
        "colors": {
          "type": "object",
          "required": [
            "brand",
            "accent"
          ],
          "properties": {
            "brand": {
              "$ref": "#/definitions/hexColor"
            },
            "brandDeep": {
              "$ref": "#/definitions/hexColor"
            },
            "brandSoft": {
              "$ref": "#/definitions/hexColor"
            },
            "brandTint": {
              "$ref": "#/definitions/hexColor"
            },
            "accent": {
              "$ref": "#/definitions/hexColor"
            },
            "accentSoft": {
              "$ref": "#/definitions/hexColor"
            },
            "accentInk": {
              "$ref": "#/definitions/hexColor"
            }
          }
        },
        "logo": {
          "type": "string"
        },
        "favicon": {
          "type": "string"
        }
      }
    },
    "terminology": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "requestCategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "screens": {
      "type": "object",
      "properties": {
        "public": {
          "$ref": "#/definitions/screenList"
        },
        "ops": {
          "$ref": "#/definitions/screenList"
        },
        "disabled": {
          "$ref": "#/definitions/screenList"
        }
      }
    },
    "home": {
      "type": "object",
      "properties": {
        "public": {
          "$ref": "#/definitions/screenList"
        },
        "ops": {
          "$ref": "#/definitions/screenList"
        }
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/entityType"
      }
    },
    "iot": {
      "type": "object",
      "description": "Fake IoT device fleet simulation, consumed by services/iot-simulator. Independent of `entities` -- devices emit OTLP metrics/logs directly, they are not entity-engine records.",
      "properties": {
        "enabled": { "type": "boolean" },
        "tickIntervalMs": {
          "type": "integer",
          "minimum": 1000,
          "description": "Default cadence at which every device mutates/emits its metrics, unless overridden per deviceType."
        },
        "deviceTypes": {
          "type": "array",
          "items": { "$ref": "#/definitions/deviceType" }
        }
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "zones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requestTemplates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "title",
              "description"
            ]
          }
        },
        "chatQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "dynatrace": {
      "type": "object",
      "properties": {
        "serviceNames": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "flowLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "flows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "correlationID": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "hexColor": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "screenList": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "id"
            ]
          }
        ]
      }
    },
    "entityType": {
      "type": "object",
      "required": [
        "displayName",
        "fields",
        "initial",
        "states"
      ],
      "properties": {
        "displayName": {
          "type": "string"
        },
        "fields": {
          "type": "object"
        },
        "initial": {
          "type": "string"
        },
        "sequence": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The ideal linear sequence of states for the journey progress bar."
        },
        "states": {
          "type": "object"
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "signal"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "signal": {
                "$ref": "#/definitions/signalDef"
              }
            }
          }
        }
      }
    },
    "signalDef": {
      "type": "object",
      "required": [
        "eventType",
        "correlationId"
      ],
      "properties": {
        "eventType": {
          "type": "string"
        },
        "correlationId": {
          "type": "string"
        }
      }
    },
    "deviceType": {
      "type": "object",
      "required": ["type", "displayName", "count", "metrics"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "displayName": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "tickIntervalMs": { "type": "integer", "minimum": 1000 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/deviceMetric" }
        },
        "logs": { "$ref": "#/definitions/deviceLogConfig" },
        "children": {
          "type": "array",
          "description": "One level of child device types (e.g. a train's doors). Children cannot have their own children.",
          "items": { "$ref": "#/definitions/childDeviceType" }
        }
      }
    },
    "childDeviceType": {
      "type": "object",
      "required": ["type", "displayName", "countPerParent", "metrics"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "displayName": { "type": "string" },
        "countPerParent": { "type": "integer", "minimum": 0 },
        "tickIntervalMs": { "type": "integer", "minimum": 1000 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/deviceMetric" }
        },
        "logs": { "$ref": "#/definitions/deviceLogConfig" }
      }
    },
    "deviceMetric": {
      "type": "object",
      "required": ["name", "min", "max", "pattern"],
      "properties": {
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "pattern": {
          "type": "string",
          "enum": ["steady", "driftRandom", "cyclic"],
          "description": "steady = small noise around a baseline; driftRandom = random walk clamped to [min,max]; cyclic = sine wave oscillating between min and max."
        },
        "periodSeconds": {
          "type": "number",
          "minimum": 1,
          "description": "Oscillation period for pattern=cyclic. Ignored otherwise."
        }
      }
    },
    "deviceLogConfig": {
      "type": "object",
      "properties": {
        "emitProbabilityPerTick": { "type": "number", "minimum": 0, "maximum": 1 },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "template"],
            "properties": {
              "level": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
              "template": {
                "type": "string",
                "description": "May reference {device_id}, {device_type}, and {parent_id}."
              }
            }
          }
        }
      }
    }
  }
}