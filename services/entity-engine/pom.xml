<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.meridian</groupId>
    <artifactId>entity-engine</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>entity-engine</name>
    <description>Meridian City Platform - Generic config-driven entity/lifecycle engine</description>

    <properties>
        <java.version>21</java.version>
        <jackson-2-bom.version>2.22.4</jackson-2-bom.version>
        <postgresql.version>42.7.14</postgresql.version>
        <!-- Was pinned to 3.3.0 (the Spring Boot 3.4.0-era default). Spring Boot 4.1.2
             manages/tests spring-kafka against Spring Framework 7 at 4.1.2 — left pinned
             at the old 3.3.0 value, this service would run spring-kafka 3.3.0 (built
             against Spring Framework 6) on top of the Spring Framework 7 artifacts the
             rest of the BOM pulls in, an untested combination. Bumped to match. -->
        <spring-kafka.version>4.1.2</spring-kafka.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Web -->
        <!-- Excludes the transitive spring-boot-starter-jackson (Spring Boot 4's
             Jackson 3 autoconfiguration, group tools.jackson.*) because this codebase's
             DTOs/config still use Jackson 2 APIs/annotations (com.fasterxml.jackson.*)
             throughout. spring-boot-jackson2 below restores Jackson 2 support via
             Spring Boot 4's official compatibility bridge. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-jackson</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Jackson 2 compatibility bridge (Spring Boot 4 defaults to Jackson 3,
             but this service's DTOs/annotations are Jackson 2 — see exclusion above). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>

        <!-- RestTemplateBuilder (RestTemplateConfig) moved out of spring-boot-starter-web's
             transitive closure in Spring Boot 4 into this standalone module. Depending on
             the module directly (not spring-boot-starter-restclient) avoids pulling in
             another transitive spring-boot-starter-jackson (Jackson 3). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
        </dependency>

        <!-- Spring Boot JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- BCrypt password hashing for "password"-type fields (e.g. the citizen entity
             type's account password) + the generic /api/v1/auth/login endpoint.
             crypto-only artifact: provides BCryptPasswordEncoder WITHOUT the full Spring
             Security filter chain (which would otherwise lock down every endpoint). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Flyway -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- PostgreSQL Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Kafka — generic kafkaTrigger bridge for entity creation from
             Kafka messages (e.g. iot.anomalies → incident). Conditional on
             entity-engine.kafka-triggers-enabled; only wired on ops-entity-service. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Logstash Logback Encoder for structured JSON logging -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>